# ==========================================
# Configuração do Banco de Dados (PostgreSQL)
# ==========================================
# URL de conexão com o banco PostgreSQL (Supabase ou local)
# Formato: postgresql://usuario:senha@host:porta/banco
SUPABASE_DATABASE_URL=postgresql://user:password@localhost:5432/gestao_academia

# ==========================================
# Configuração do Redis
# ==========================================
# Host do Redis (default: localhost)
REDIS_HOST=localhost
# Porta do Redis (default: 6379)
REDIS_PORT=6379

# ==========================================
# Configuração da Aplicação
# ==========================================
# Porta do servidor (default: 8080)
SERVER_PORT=8080
# Nome da aplicação
SPRING_APPLICATION_NAME=sistema-gestao-academia

# ==========================================
# Configuração do Spring Profiles
# ==========================================
# Perfil ativo (ex: dev, prod, test)
# SPRING_PROFILES_ACTIVE=dev
